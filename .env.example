# ==============================================================================
# PDVolts Industrial - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your actual values.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB / SQLite / PostgreSQL)
# ------------------------------------------------------------------------------
# Option A: MongoDB Atlas (Cloud - Recommended for Production)
# Create a free cluster at https://cloud.mongodb.com
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/pdvolts?retryWrites=true&w=majority"

# Option B: Local MongoDB
# DATABASE_URL="mongodb://127.0.0.1:27017/pdvolts"

# Option C: Local SQLite (Zero-config development fallback)
# DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# 2. EMAIL INTEGRATION (Nodemailer SMTP & Admin Notifications)
# ------------------------------------------------------------------------------
# All customer enquiries, quote requests (RFQs), and password reset emails are sent via this SMTP.
# Leave SMTP_HOST empty if you want emails to print to the development server console instead of sending.

# For Gmail:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification
# 3. Search for "App Passwords" (or go to https://myaccount.google.com/apppasswords)
# 4. Create an app named "PDVolts" and copy the 16-character password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="yourbusiness@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM="PDVolts Industrial <yourbusiness@gmail.com>"

# The Admin / Owner Email address where all incoming customer enquiries and quote requests will be sent:
ADMIN_EMAIL="admin@pdvolts.com"

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Random secure secret string used for signing JWT login tokens (minimum 32 characters)
JWT_SECRET="pdvolts_ultra_secure_jwt_signing_secret_key_prod_2026_xyz"

# ------------------------------------------------------------------------------
# 4. APPLICATION & BRAND SETTINGS
# ------------------------------------------------------------------------------
# Base URL of the website
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Public Company Name displayed across the portal
NEXT_PUBLIC_COMPANY_NAME="PDVolts Industries"

# ------------------------------------------------------------------------------
# 5. FILE UPLOADS
# ------------------------------------------------------------------------------
STORAGE_PROVIDER="local"
UPLOAD_DIR="./public/uploads"
